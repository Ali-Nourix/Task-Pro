{
  "name": "taskpro",
  "version": "1.5.0",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/recurrence.mjs && node test/focus-timer.mjs && node test/tags.mjs && node test/board.mjs && node test/calendar.mjs && node test/plugin-edits.mjs",
    "test:ui": "node test/board-interactions.mjs && node test/calendar-interactions.mjs",
    "check:contrast": "node test/contrast-check.mjs",
    "previews": "node test/render-previews.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "description": "TaskPro — an Obsidian plugin for task management with per-task capabilities.",
  "license": "MIT"
}
